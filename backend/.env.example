# Wands engine — environment template.
# Copy to .env and fill in. Never commit the filled file.

# --- Runtime ---------------------------------------------------------------
WANDS_ENVIRONMENT=development
WANDS_LOG_LEVEL=INFO
WANDS_REGION=self-hosted

# --- Database --------------------------------------------------------------
# PostgreSQL only. The engine refuses to start in production on SQLite.
WANDS_DATABASE_URL=postgresql+psycopg://wands:change-me@postgres:5432/wands
WANDS_DATABASE_POOL_SIZE=5
WANDS_DATABASE_ECHO=false

# --- Redis (workers, queues, rate limits) ----------------------------------
WANDS_REDIS_URL=redis://redis:6379/0

# --- Credentials -----------------------------------------------------------
# Service token used by the Next.js BFF. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WANDS_ENGINE_TOKEN=

# Fernet key for encrypting broker credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key requires re-encrypting stored credentials.
WANDS_ENCRYPTION_KEY=

# Pepper mixed into API key hashes.
WANDS_API_KEY_PEPPER=

# --- Trading safety --------------------------------------------------------
# backtest | paper | live. Live additionally requires the flag below AND an
# authenticated admin action recorded in the audit log.
WANDS_TRADING_MODE=paper
WANDS_LIVE_TRADING_ENABLED=false

# Block new risk-increasing orders when the last broker sync is older than this.
WANDS_MAX_ACCOUNT_STATE_AGE_SECONDS=300
# Block orders when the quoted spread exceeds this percentage.
WANDS_MAX_SPREAD_PCT=1.0

# --- HTTP ------------------------------------------------------------------
# Comma-separated. The Vercel frontend origin goes here.
WANDS_ALLOWED_ORIGINS=
WANDS_REQUEST_TIMEOUT_SECONDS=15

# --- Observability ---------------------------------------------------------
# Leave empty to disable OTLP export.
WANDS_OTEL_EXPORTER_OTLP_ENDPOINT=
