# Wands engine — environment template.
# Copy to .env and fill in. Never commit the filled file.

# --- Runtime ---------------------------------------------------------------
WANDS_ENVIRONMENT=development
WANDS_LOG_LEVEL=INFO
WANDS_REGION=self-hosted

# --- Database --------------------------------------------------------------
# PostgreSQL only. The engine refuses to start in production on SQLite.
WANDS_DATABASE_URL=postgresql+psycopg://wands:change-me@postgres:5432/wands
WANDS_DATABASE_POOL_SIZE=5
WANDS_DATABASE_ECHO=false

# --- Redis (workers, queues, rate limits) ----------------------------------
WANDS_REDIS_URL=redis://redis:6379/0

# --- Credentials -----------------------------------------------------------
# Service token used by the Next.js BFF. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WANDS_ENGINE_TOKEN=

# Fernet key for encrypting broker credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key requires re-encrypting stored credentials.
WANDS_ENCRYPTION_KEY=

# Pepper mixed into API key hashes.
WANDS_API_KEY_PEPPER=

# --- Trading safety --------------------------------------------------------
# backtest | paper | live. Live additionally requires the flag below AND an
# authenticated admin action recorded in the audit log.
WANDS_TRADING_MODE=paper
WANDS_LIVE_TRADING_ENABLED=false

# Block new risk-increasing orders when the last broker sync is older than this.
WANDS_MAX_ACCOUNT_STATE_AGE_SECONDS=300
# Block orders when the quoted spread exceeds this percentage.
WANDS_MAX_SPREAD_PCT=1.0

# --- Market data -----------------------------------------------------------
# Set to false to construct no provider at all (the test suite does this so it
# can never depend on a live venue being reachable).
WANDS_MARKET_DATA_ENABLED=true
# Comma-separated. BASE/QUOTE is a crypto pair; anything else is an equity.
WANDS_MARKET_WATCHLIST=BTC/USD,ETH/USD,SOL/USD,XRP/USD,AAPL,MSFT,NVDA,SPY
WANDS_MARKET_REFRESH_SECONDS=30
WANDS_MARKET_CANDLE_LIMIT=200
WANDS_MARKET_DATA_TIMEOUT_SECONDS=10
WANDS_MARKET_DATA_MAX_RETRIES=3
# Background refresh loop. Disable when running a single-shot process.
WANDS_MARKET_DATA_WORKER_ENABLED=true

# Kraken public market data needs no credentials.
WANDS_KRAKEN_BASE_URL=https://api.kraken.com
WANDS_KRAKEN_RATE_LIMIT_PER_SECOND=2.0

# Alpaca market data. Leave the key/secret empty to disable the stock feed;
# the engine then reports stocks as unavailable rather than inventing prices.
WANDS_ALPACA_DATA_KEY=
WANDS_ALPACA_DATA_SECRET=
WANDS_ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# iex = real-time but single-venue. sip = consolidated and, on a free plan,
# delayed. Set WANDS_ALPACA_DATA_DELAYED=true when the account is not entitled
# to real-time SIP so the data is never labelled live.
WANDS_ALPACA_DATA_FEED=iex
WANDS_ALPACA_DATA_DELAYED=false

# --- Portfolio -------------------------------------------------------------
WANDS_PAPER_DEFAULT_STARTING_CASH=100000
WANDS_PAPER_DEFAULT_CURRENCY=USD
# Manual FX snapshots, e.g. "EURUSD=1.0850,GBPUSD=1.2700". Stored with a
# timestamp; nothing is inverted or interpolated at read time.
WANDS_FX_RATE_OVERRIDES=
WANDS_FX_MAX_AGE_SECONDS=86400

# --- HTTP ------------------------------------------------------------------
# Comma-separated. The Vercel frontend origin goes here.
WANDS_ALLOWED_ORIGINS=
WANDS_REQUEST_TIMEOUT_SECONDS=15

# --- Observability ---------------------------------------------------------
# Leave empty to disable OTLP export.
WANDS_OTEL_EXPORTER_OTLP_ENDPOINT=
