# Railway environment for the Wands engine.
#
# Copy these keys into the Railway service's Variables tab. Never commit real
# values. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # tokens
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Railway injects PORT itself. Do not set it.

# --- required ---------------------------------------------------------------

# production turns on the stricter startup checks. Do not use development on a
# host that holds real data.
WANDS_ENVIRONMENT=production

# The isolated engine database, NOT the Next.js application database.
# Scheme must be postgresql+psycopg:// for the psycopg 3 driver.
# Neon: use the -pooler host for the app and the direct host for migrations.
WANDS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/wands_engine?sslmode=require

# Server-to-server credential the Next.js BFF presents. Never reaches a browser.
WANDS_ENGINE_TOKEN=

# Fernet key. Required before any broker credential can be stored, and before
# MFA secrets can be read. The engine starts without it, but connections and
# MFA fail closed until it is set.
WANDS_ENCRYPTION_KEY=

# --- strongly recommended ---------------------------------------------------

# Peppers the SHA-256 hash of every API key secret. Changing it invalidates
# every issued key.
WANDS_API_KEY_PEPPER=

# The Vercel production origin, so the browser can call the engine directly if
# that is ever needed. Comma separated, no trailing slash.
WANDS_ALLOWED_ORIGINS=https://wands.vercel.app

# 0.5 GB RAM on the Railway free plan. The default pool of 5 is too wide.
WANDS_DATABASE_POOL_SIZE=2

# --- safety switches: leave off until explicitly authorised -----------------

# Live trading. Must stay false. verify_deployment.py fails the host if true.
WANDS_LIVE_TRADING_ENABLED=false

# SEC collection. Turning this on requires a real contact in
# WANDS_SEC_USER_AGENT or the settings validator refuses to start.
WANDS_INTELLIGENCE_INGEST_ENABLED=false
WANDS_SEC_USER_AGENT=

# The in-process job scheduler. One instance only: a second replica would run a
# second scheduler against the same tables.
WANDS_INTELLIGENCE_JOBS_ENABLED=false

# The in-process market-data poller. Off initially to stay inside 0.5 GB.
WANDS_MARKET_DATA_WORKER_ENABLED=false

# --- optional ---------------------------------------------------------------

WANDS_LOG_LEVEL=INFO

# Leave unset. Setting this to '*' would let any caller forge the client address
# recorded in the audit trail. Unset means the audit trail records the proxy
# address instead of the true client, which is the safe direction to be wrong.
# WANDS_FORWARDED_ALLOW_IPS=
