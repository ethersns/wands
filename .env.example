# Frontend environment template.
#
# Every variable here is SERVER-ONLY. None of them may be prefixed with
# NEXT_PUBLIC_ — the browser must never hold an engine credential, an operator
# password or a founder allowlist.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string. In development this must point at a database that
# is NOT the production database. See docs/secure-infra-engine-readiness.md.
DATABASE_URL=

# Which database this process is talking to: development, test or production.
#
# This is a declaration, not a detection. The operator gate reads it to decide
# whether the development bypass may activate, so leaving it unset keeps the
# gate closed. Set it to `production` on the production deployment.
WANDS_DATABASE_ENV=

# ---------------------------------------------------------------------------
# Operator gate
# ---------------------------------------------------------------------------

# Shared operator credentials for the trading console. All three are required
# together; if any is missing the gate is unconfigured and fails closed.
WANDS_OPERATOR_USERNAME=
WANDS_OPERATOR_PASSWORD=

# HMAC key for the signed operator session cookie. Generate with:
#   openssl rand -base64 32
WANDS_SESSION_SECRET=

# Explicit, isolated development bypass for the operator gate.
#
# Set to 1 ONLY on a local machine whose DATABASE_URL points at a development
# database. It is ignored in a production build, and ignored when
# WANDS_DATABASE_ENV is not `development` or `test`. Never set it on a
# deployment that can reach production data.
WANDS_DEV_OPERATOR_BYPASS=

# ---------------------------------------------------------------------------
# Founder access
# ---------------------------------------------------------------------------

# Comma-separated Better Auth user ids allowed to operate the Opportunity Desk.
# Fails closed: absent or empty grants nobody. There is no "first user wins"
# path. Retrieve an id with:
#   select id from "user" where email = '<founder email>';
# Never commit the value, and never log it.
WANDS_FOUNDER_USER_IDS=

# ---------------------------------------------------------------------------
# Engine connection
# ---------------------------------------------------------------------------

# Base URL of the private Wands engine (see backend/README.md).
# Leave unset to run the UI on demonstration fixtures, which are labelled
# provenance: "demo" on every screen.
WANDS_ENGINE_URL=

# Service token shared with the engine (WANDS_ENGINE_TOKEN on the engine host).
WANDS_ENGINE_TOKEN=

# Least-privilege credential for the member research surface. Mint it on the
# engine with `python -m scripts.create_research_key --email <address>`; it
# carries `research:read` and nothing else, so `deny_research_only` keeps it off
# every operator surface. There is deliberately no fallback to
# WANDS_ENGINE_TOKEN: a member request that borrowed it could place orders, read
# credentials and control jobs. Leave it unset and member research renders
# `unavailable` rather than widening to the whole engine.
WANDS_RESEARCH_TOKEN=
