# Frontend environment template.
#
# Both variables are SERVER-ONLY. They are read by the Next.js BFF proxy in
# app/api/wands/[...path]/route.ts and by lib/api/client.ts. Never prefix them
# with NEXT_PUBLIC_ — the browser must never hold the engine credential.
#
# Leave them unset to run the UI on demonstration fixtures, which are labelled
# provenance: "demo" on every screen.

# Base URL of the private Wands engine (see backend/README.md).
WANDS_ENGINE_URL=

# Service token shared with the engine (WANDS_ENGINE_TOKEN on the engine host).
WANDS_ENGINE_TOKEN=
